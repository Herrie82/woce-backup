#!/bin/sh
#
# postinst - installs the privileged helper. Runs as root under ipkg, which
# means Preware or WebOS Quick Install. palm-install runs as a non-root user
# and will NOT execute this; the app still works in that case, just in limited
# mode (see README).
#

APP_DIR="/media/cryptofs/apps/usr/palm/applications/com.palm.app.backup"
NODE="/usr/palm/nodejs/node"
ROM_APP="/usr/palm/applications/com.palm.app.backup"
ROM_BACKUP="/var/luna/com.palm.app.backup.woce-orig"
EXPECT_OSVER="3.0.5"

# --- supplant the built-in Backup app ----------------------------------------
#
# Installing to /media/cryptofs does NOT override a ROM app of the same id.
# Measured on stock 3.0.5, with this app declaring a HIGHER version than the
# built-in (3.1.0 vs 2.0.0) and after a reboot: the launcher entry, getAppInfo
# and the running card all still resolved to
# /usr/palm/applications/com.palm.app.backup. The app installed perfectly and
# then sat there while the tile went on launching the dead built-in - which
# talks to com.palm.service.backup and cannot write a thing. Version does not
# decide it; the ROM copy simply wins.
#
# So the ROM copy is moved aside, the same way the TLS packages swap a stock
# binary: back it up ONCE, keep the restore point, put it back in prerm.
#
# Guards, in order of how badly each would end:
#   * Only ever move a copy that is NOT ours. On webOS CE the ROM copy IS this
#     app (baked into the image), and moving it would delete the working one.
#     Checked by content, not by version, so it holds for every build.
#   * Only on the webOS version this targets. A different build's Backup app is
#     not ours to reason about.
#   * Never overwrite an existing restore point: the first one is the stock one.
is_ours() { grep -q "webOS Community Edition" "$1/appinfo.json" 2>/dev/null; }

osv=$(sed -n 's/^PRODUCT_VERSION_STRING=.* \([0-9][0-9.]*\)$/\1/p' /etc/palm-build-info 2>/dev/null | head -1)

if [ ! -d "$ROM_APP" ]; then
    echo "  no built-in Backup app to supplant"
elif is_ours "$ROM_APP"; then
    echo "  the built-in Backup app is already this app (baked image) - leaving it alone"
elif [ -n "$osv" ] && [ "$osv" != "$EXPECT_OSVER" ]; then
    echo "  WARNING: this device reports webOS $osv, not $EXPECT_OSVER."
    echo "  NOT moving its built-in Backup app aside - the launcher will keep"
    echo "  launching the built-in one instead of this app."
else
    WASRO=0
    awk '$2=="/" && $1!="rootfs"' /proc/mounts 2>/dev/null | grep -q "[ ,]ro[ ,]" && WASRO=1
    mount -o remount,rw / 2>/dev/null || true

    if [ -d "$ROM_BACKUP" ] && is_ours "$ROM_BACKUP"; then
        echo "  discarding a restore point that is one of our own builds, not the stock app"
        rm -rf "$ROM_BACKUP"
    fi
    if [ ! -d "$ROM_BACKUP" ]; then
        mkdir -p /var/luna 2>/dev/null
        cp -a "$ROM_APP" "$ROM_BACKUP" 2>/dev/null
    fi
    if [ -d "$ROM_BACKUP" ]; then
        rm -rf "$ROM_APP"
        echo "  moved the built-in Backup app aside (restore point: $ROM_BACKUP)"
    else
        echo "  WARNING: could not back up $ROM_APP - leaving it in place."
        echo "  The launcher will keep launching the built-in Backup app."
    fi

    [ "$WASRO" = 1 ] && mount -o remount,ro / 2>/dev/null
    true
fi

echo "woce-backup: installing the privileged helper..."

if [ ! -x "$NODE" ]; then
    echo "  no node runtime at $NODE - skipping helper, app will run in limited mode"
    exit 0
fi

# The helper must live outside the app bundle: /media/cryptofs is mounted
# nosuid and the jail cannot reach it from the service side either.
cp "$APP_DIR/device/woce-backupd.js" /usr/bin/woce-backupd.js
chmod 755 /usr/bin/woce-backupd.js
echo "  installed /usr/bin/woce-backupd.js"

cp "$APP_DIR/device/woce-backupd.conf" /etc/event.d/woce-backupd
chmod 644 /etc/event.d/woce-backupd
echo "  installed the upstart job"

# The working tree is shared with the jailed service; create it now so the
# first backup does not race on it.
mkdir -p /media/internal/.woce-backup/jobs
mkdir -p /media/internal/.woce-backup/stage
mkdir -p /media/internal/.woce-backup/manifests
chmod -R 777 /media/internal/.woce-backup 2>/dev/null

# Start straight away so no reboot is needed. No ls2 role file is installed:
# /usr/share/ls2/roles/prv/com.palm.nodejs.json already grants the node binary
# a privileged role with allowedNames ["*"], and /usr/share takes precedence
# over /var/palm, so anything we dropped there would be ignored.
# Stop before starting. `start` on a job that is already running is a no-op,
# so an upgrade would leave the previous daemon serving the previous code —
# which is exactly how "Unknown op: lunacall" happened after the op was added.
stop woce-backupd 2>/dev/null >/dev/null && echo "  stopped the previous woce-backupd" || true

# Belt and braces: upstart occasionally keeps the process after the job stops.
pkill -f woce-backupd.js 2>/dev/null >/dev/null || true

start woce-backupd 2>/dev/null && echo "  started woce-backupd" \
    || echo "  woce-backupd will start on next boot"

echo "woce-backup: install complete."
exit 0
